# Copy to .env.deploy and fill in before `docker compose --env-file .env.deploy up -d --build`.
# Never commit .env.deploy — it holds the ingest bearer token.

# Public domain pointed at this host (A/AAAA record). Caddy requests a
# Let's Encrypt certificate for it automatically — ports 80 and 443 must be
# reachable from the internet for the ACME challenge to succeed.
DOMAIN=witness.example.org

# Shared secret required (as `Authorization: Bearer <token>`) for evidence
# uploads and LoRa receipt ingestion. Generate one with:
#   openssl rand -hex 32
# Configure the SAME value in the Witness app: Settings -> Mesh Provisioning
# -> Ingestion Endpoint URL, and apps/pwa/.env's VITE_TUS_ENDPOINT auth.
INGEST_TOKEN=change-me-to-a-random-secret

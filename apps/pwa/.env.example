# Witness PWA — environment variables
# Copy to .env and fill in your values. Never commit .env to version control.

# tus resumable-upload endpoint for encrypted evidence blobs.
# For the bundled ingestion server (apps/server, `pnpm --filter @witness/server dev`):
VITE_TUS_ENDPOINT=http://localhost:3001/files

# Alternative: a vault base URL (e.g. Supabase). If VITE_TUS_ENDPOINT is unset,
# the tus endpoint is derived as $VITE_VAULT_ENDPOINT/storage/v1/upload/resumable.
VITE_VAULT_ENDPOINT=
# Sent as "Authorization: Bearer $VITE_VAULT_KEY" on every tus upload. If the
# bundled server (apps/server) is deployed with INGEST_TOKEN set, use the same
# value here.
VITE_VAULT_KEY=

# The LoRa mesh ingestion endpoint (HashReceipt POSTs) is configured at runtime
# in the app: Settings → Mesh Provisioning → Ingestion Endpoint URL, e.g.
#   http://localhost:3001/ingest
# If that server requires a bearer token (INGEST_TOKEN), set it in the same
# panel under Ingestion Token — it is sent as "Authorization: Bearer <token>".
